{
  "id": "/",
  "name": "Nabikaran — Renewal reminders",
  "short_name": "Nabikaran",
  "description": "SMS and WhatsApp reminders before your Bluebook, licence, passport, insurance, tax and business renewals in Nepal.",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
