# Copy to .env.local. Never commit real values.

APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Postgres connection string (service role / direct). Required outside tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nabikaran

# Secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=
OTP_PEPPER=
WORKER_TOKEN=

# SMS provider: mock (dev) | aakash
SMS_PROVIDER=mock
AAKASH_AUTH_TOKEN=
AAKASH_SEND_URL=https://sms.aakashsms.com/sms/v3/send
AAKASH_REPORT_URL=https://sms.aakashsms.com/sms/v3/report

# Payment gateway: mock (dev) | khalti
PAYMENT_GATEWAY=mock
KHALTI_SECRET_KEY=
# sandbox: https://dev.khalti.com   production: https://a.khalti.com
KHALTI_BASE_URL=https://dev.khalti.com

# OAuth 2.1 / MCP (Phase 1+). Issuer is the web origin; resource is the MCP endpoint tokens are bound to.
OAUTH_ISSUER=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3000/mcp
# Hostname that should serve the MCP endpoint at "/" (rewrite to /mcp). Leave empty locally.
MCP_HOST=
