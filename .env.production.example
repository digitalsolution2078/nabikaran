# Copy to .env.production on the VPS (never commit). Generate secrets with: openssl rand -hex 32

# --- Database (docker-compose creates it) ---
POSTGRES_DB=nabikaran
POSTGRES_USER=nabikaran
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- App ---
APP_URL=https://nabikaran.org
APP_PORT=3100                      # host port published on 127.0.0.1 for your reverse proxy
SESSION_SECRET=CHANGE_ME
OTP_PEPPER=CHANGE_ME
WORKER_TOKEN=CHANGE_ME             # used by the cron container to call /api/jobs/*

# --- OAuth 2.1 / MCP ---
OAUTH_ISSUER=https://nabikaran.org
MCP_HOST=mcp.nabikaran.org
MCP_PUBLIC_URL=https://mcp.nabikaran.org/mcp
TOKEN_CACHE_SECONDS=30

# --- SMS: start with mock, switch to aakash after the written quote + sandbox check ---
SMS_PROVIDER=mock
AAKASH_AUTH_TOKEN=
AAKASH_SEND_URL=https://sms.aakashsms.com/sms/v3/send
AAKASH_REPORT_URL=https://sms.aakashsms.com/sms/v3/report

# --- Payments: start with mock, switch to khalti after merchant approval ---
PAYMENT_GATEWAY=mock
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com

# Fonepay dynamic QR (automatic QR top-ups). Get these from Fonepay / your
# acquiring bank's merchant onboarding. Leave FONEPAY_MODE=off to keep the
# static QR + admin verification flow.
FONEPAY_MODE=off
FONEPAY_MERCHANT_CODE=
FONEPAY_USERNAME=
FONEPAY_PASSWORD=
FONEPAY_SECRET_KEY=
# FONEPAY_API_BASE=https://merchantapi.fonepay.com/api/merchant/merchantDetailsForThirdParty

# WhatsApp (Meta Cloud API). Secrets live ONLY here, never in the admin panel.
# off = no WhatsApp; meta = live; mock = development. Then enable it and set the
# phone number ID in Admin -> Channels & pricing. Webhook URL:
#   https://<your-domain>/api/webhooks/whatsapp   (verify token = WHATSAPP_VERIFY_TOKEN)
WHATSAPP_PROVIDER=off
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0

# Shown on Privacy, Terms and receipts.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
