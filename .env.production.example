# Copy to .env.production on the VPS (never commit). Generate secrets with: openssl rand -hex 32

# --- Database (docker-compose creates it) ---
POSTGRES_DB=nabikaran
POSTGRES_USER=nabikaran
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# --- App ---
APP_URL=https://nabikaran.org
APP_PORT=3100                      # host port published on 127.0.0.1 for your reverse proxy
SESSION_SECRET=CHANGE_ME
OTP_PEPPER=CHANGE_ME
WORKER_TOKEN=CHANGE_ME             # used by the cron container to call /api/jobs/*

# --- OAuth 2.1 / MCP ---
OAUTH_ISSUER=https://nabikaran.org
MCP_HOST=mcp.nabikaran.org
MCP_PUBLIC_URL=https://mcp.nabikaran.org/mcp
TOKEN_CACHE_SECONDS=30

# --- SMS: start with mock, switch to aakash after the written quote + sandbox check ---
SMS_PROVIDER=mock
AAKASH_AUTH_TOKEN=
AAKASH_SEND_URL=https://sms.aakashsms.com/sms/v3/send
AAKASH_REPORT_URL=https://sms.aakashsms.com/sms/v3/report

# --- Payments: start with mock, switch to khalti after merchant approval ---
PAYMENT_GATEWAY=mock
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com
